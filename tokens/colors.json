{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "SaaS B2B Design System - Colors",
    "modes": [
      "dark",
      "light"
    ],
    "version": "0.6.2"
  },
  "primary": {
    "50": "#F0F9F8",
    "100": "#D9F2EE",
    "200": "#B0E3DB",
    "300": "#7DCFC1",
    "400": "#40B5A2",
    "500": "#2A7F71",
    "600": "#21695D",
    "700": "#195249",
    "800": "#123F38",
    "900": "#0C2C27",
    "description": "Verdigris (cobre oxidado) — acento da marca Inonav desde v0.6.0, substituindo o cobre #C97C1B. Significa ESTADO (foco, selecao, aba ativa, switch ligado), nao acao: o botao primario usa os tokens action-*. Matiz 170, a 28 graus do verde de sucesso (142) — mesma familia, sem confundir foco com 'deu certo'.",
    "base": "#2A7F71"
  },
  "secondary": {
    "50": "#ECF9F6",
    "100": "#CFF0E9",
    "200": "#A0E0D3",
    "300": "#6CCBBA",
    "400": "#48B4A1",
    "500": "#359C8B",
    "600": "#2A7F71",
    "700": "#21645A",
    "800": "#194B44",
    "900": "#11332E",
    "description": "Cobre oxidado (verdigris/pátina). Desde v0.5.0 nenhum componente do kit usa esta rampa: o botão secundário virou contorno neutro e os links viraram neutros. Fica disponível para consumidores.",
    "base": "#359C8B"
  },
  "neutral": {
    "0": "#FFFFFF",
    "50": "#F9FAFB",
    "100": "#F0F2F5",
    "200": "#DEE2E7",
    "300": "#C2C8D1",
    "400": "#929BAA",
    "500": "#677283",
    "600": "#4C5667",
    "700": "#353F50",
    "800": "#232D3E",
    "900": "#17202E",
    "950": "#0D131C",
    "description": "Derivada do azul-petroleo da marca (#17202E = 900), nao do cinza generico. Saturacao cai conforme clareia."
  },
  "feedback": {
    "error": {
      "base": "#EF4444",
      "soft-dark": "#7F1D1D",
      "soft-light": "#FEE2E2"
    },
    "success": {
      "base": "#22C55E",
      "soft-dark": "#14532D",
      "soft-light": "#DCFCE7"
    },
    "warning": {
      "base": "#F59E0B",
      "soft-dark": "#78350F",
      "soft-light": "#FEF3C7"
    },
    "info": {
      "base": "#3B82F6",
      "soft-dark": "#1E3A8A",
      "soft-light": "#DBEAFE"
    }
  },
  "semantic": {
    "dark": {
      "surface": {
        "base": "#17202E",
        "elevated": "#232D3E",
        "overlay": "#353F50",
        "muted": "rgba(255, 255, 255, 0.06)",
        "mutedHover": "rgba(255, 255, 255, 0.10)"
      },
      "border": {
        "subtle": "#323C4E",
        "default": "#353F50",
        "strong": "#4C5667",
        "focus": "#2A7F71"
      },
      "text": {
        "primary": "#E2E5E9",
        "secondary": "#B8BDC7",
        "tertiary": "#929BAA",
        "disabled": "#677283",
        "inverse": "#17202E",
        "onPrimary": "#FFFFFF",
        "onSecondary": "#17202E",
        "onDanger": "#17202E",
        "onAction": "#17202E",
        "onMuted": "#DEE2E7",
        "link": "#E2E5E9",
        "linkHover": "#B8BDC7"
      },
      "action": {
        "solid": "#E2E5E9",
        "solidHover": "#F0F2F5",
        "solidActive": "#C2C8D1"
      },
      "backdrop": "rgba(0, 0, 0, 0.6)",
      "primaryOnSoft": "#7DCFC1"
    },
    "light": {
      "surface": {
        "base": "#F9FAFB",
        "elevated": "#FFFFFF",
        "overlay": "#FFFFFF",
        "muted": "rgba(23, 32, 46, 0.05)",
        "mutedHover": "rgba(23, 32, 46, 0.09)"
      },
      "border": {
        "subtle": "#F0F2F5",
        "default": "#DEE2E7",
        "strong": "#C2C8D1",
        "focus": "#2A7F71"
      },
      "text": {
        "primary": "#17202E",
        "secondary": "#353F50",
        "tertiary": "#677283",
        "disabled": "#929BAA",
        "inverse": "#F9FAFB",
        "onPrimary": "#FFFFFF",
        "onSecondary": "#17202E",
        "onDanger": "#17202E",
        "onAction": "#FFFFFF",
        "onMuted": "#353F50",
        "link": "#17202E",
        "linkHover": "#353F50"
      },
      "action": {
        "solid": "#17202E",
        "solidHover": "#232D3E",
        "solidActive": "#0D131C"
      },
      "backdrop": "rgba(23, 32, 46, 0.5)",
      "primaryOnSoft": "#21695D"
    }
  }
}
